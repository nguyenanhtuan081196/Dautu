rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      // Only the fixed Admin identity may access Admin-managed Firestore data
      // without email verification. Ordinary users remain subject to verification.
      return isSignedIn()
        && userEmail() == 'nguyenanhtuan081196@gmail.com';
    }
    function isOwner(email) {
      return isSignedIn() && userEmail() == email.lower();
    }
    match /allowed_users/{email} {
      allow get: if isAdmin() || isOwner(email);
      allow list: if isAdmin();
      // Account membership is managed only by the trusted Admin identity.
      // Firebase client registration must never create or mutate authorization records.
      allow create, update, delete: if isAdmin();
    }
    match /watchlists/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
